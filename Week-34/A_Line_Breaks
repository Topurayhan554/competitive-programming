#include <iostream>
#include <vector>
#include <string>

using namespace std;

void solve() {
    int n, m;
    cin >> n >> m;
    
    int count = 0;
    int current_len = 0;
    bool overflow = false;
    
    for (int i = 0; i < n; i++) {
        string s;
        cin >> s;
        if (!overflow && current_len + s.length() <= m) {
            current_len += s.length();
            count++;
        } else {
            overflow = true;
        }
    }
    
    cout << count << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
